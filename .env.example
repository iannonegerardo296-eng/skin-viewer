# Copia questo file in .env.local (locale) o impostane le variabili nel
# progetto Vercel (Settings -> Environment Variables) per il deploy.

# Primo account admin: creato automaticamente al primo avvio SOLO se
# entrambe le variabili sono impostate. Senza queste due variabili non
# viene creato nessun admin di default: registra un utente normale e
# promuovilo a mano nel database.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Database (Turso / libSQL) - obbligatorio per un deploy Vercel persistente.
# In locale, se lasciate vuote, l'app usa un file SQLite in data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
