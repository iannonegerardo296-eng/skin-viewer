{
  "name": "banco-controllo-skin",
  "version": "3.0.0",
  "description": "Skin Control Center: revisione, catalogo e amministrazione di skin Minecraft",
  "private": true,
  "author": "Skin Inspector Team",
  "license": "MIT",
  "keywords": [
    "minecraft",
    "skin",
    "inspector",
    "3d-viewer",
    "typescript",
    "admin-dashboard"
  ],
  "scripts": {
    "dev": "npm run build && node --experimental-sqlite dist/server/index.js",
    "dev:static": "python -m http.server 8000",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc -p tsconfig.browser.json",
    "test": "node --test tests/**/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}